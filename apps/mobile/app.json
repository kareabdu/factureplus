{
  "expo": {
    "name": "FacturePlus",
    "slug": "factureplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "factureplus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.applikare.factureplus",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.applikare.factureplus",
      "adaptiveIcon": {
        "backgroundColor": "#147A2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "FacturePlus utilise la caméra pour scanner les codes-barres de vos produits.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FacturePlus accède à vos photos pour illustrer vos produits et ajouter votre logo.",
          "cameraPermission": "FacturePlus utilise la caméra pour photographier vos produits."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "FacturePlus accède à vos contacts pour créer un client à partir d'un contact choisi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
