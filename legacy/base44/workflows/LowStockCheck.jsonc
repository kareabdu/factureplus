      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_low_stock": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkLowStockAlerts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "V\u00e9rifier le stock bas",
            "description": "Cr\u00e9e les alertes + email propri\u00e9taires"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
