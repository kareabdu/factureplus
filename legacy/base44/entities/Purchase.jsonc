{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence de l'achat (ACH-XXXXXXXX)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date de l'achat"
    },
    "supplier_id": {
      "type": "string",
      "description": "Fournisseur (r\u00e9f\u00e9rence)"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nom du fournisseur (snapshot)"
    },
    "items": {
      "type": "array",
      "description": "Articles achet\u00e9s",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "R\u00e9f\u00e9rence produit"
          },
          "product_name": {
            "type": "string",
            "description": "Nom du produit (snapshot)"
          },
          "unit": {
            "type": "string",
            "description": "Unit\u00e9 (snapshot)"
          },
          "quantity": {
            "type": "number",
            "description": "Quantit\u00e9 achet\u00e9e",
            "default": 0
          },
          "unit_price": {
            "type": "number",
            "description": "Prix d'achat unitaire",
            "default": 0
          },
          "total": {
            "type": "number",
            "description": "Total de la ligne",
            "default": 0
          }
        },
        "required": [
          "product_name",
          "quantity"
        ]
      }
    },
    "total_amount": {
      "type": "number",
      "description": "Montant total de l'achat",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "wave",
        "orange_money",
        "card",
        "credit"
      ],
      "default": "cash",
      "description": "Moyen de paiement"
    },
    "paid_amount": {
      "type": "number",
      "description": "Montant pay\u00e9",
      "default": 0
    },
    "notes": {
      "type": "string",
      "description": "Notes",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "cancelled"
      ],
      "default": "received",
      "description": "Statut de l'achat"
    },
    "team_id": {
      "type": "string",
      "description": "\u00c9quipe propri\u00e9taire"
    }
  },
  "required": [
    "reference",
    "date",
    "items"
  ],
  "rls": {
    "create": {
      "data.team_id": "{{user.data.team_id}}"
    },
    "read": {
      "$or": [
        {
          "data.team_id": "{{user.data.team_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.team_id": "{{user.data.team_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.team_id": "{{user.data.team_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}