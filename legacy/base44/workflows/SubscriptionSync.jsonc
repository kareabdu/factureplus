{
  "name": "Synchronisation des abonnements",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "subscription_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_subscriptions": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "auditSubscriptions",
            "args": {
              "fix": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Corriger les abonnements expir\u00e9s",
            "description": "Statut realign\u00e9 sur les paiements"
          }
        }
      }
    ]
  },
  "description": "Chaque nuit, r\u00e9aligne le statut des abonnements expir\u00e9s sur la r\u00e9alit\u00e9 des paiements (active \u2192 expired).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}